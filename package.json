{
  "name": "pokecells",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dead Cells x Skul 스타일 2D 횡스크롤 포켓몬 로그라이트 (팬메이드, 개인 비상업 용도)",
  "scripts": {
    "fetch-assets": "node scripts/fetch-assets.js",
    "fetch-items": "node scripts/fetch-items.js",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "build:single": "node scripts/build-single.js",
    "make-logo": "node scripts/make-logo.js",
    "package": "node scripts/make-logo.js && node scripts/build-single.js && node scripts/package-zip.js",
    "package:itch": "node scripts/package-itch.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --nojekyll -u \"strongdragon98-art <strongdragon98-art@users.noreply.github.com>\"",
    "make-pwa-icons": "node scripts/make-pwa-icons.js",
    "make-videos": "node scripts/make-videos.js",
    "make-fonts": "node scripts/make-fonts.js"
  },
  "dependencies": {
    "galmuri": "^2.40.3",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.2.0",
    "gh-pages": "^6.3.0",
    "pngjs": "^7.0.0",
    "subset-font": "^2.9.0",
    "vite": "^8.3.5"
  }
}
